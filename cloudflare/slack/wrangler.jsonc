// wasmcloud-slack: the forward to the Slack invite at slack.wasmcloud.com.
// See src/index.js. It is deployed by hand, from this folder, logged in to
// the Cloudflare account that owns the wasmcloud.com zone:
//
//   npx --yes wrangler@4.160.1 deploy
//
// It is not part of the deploy workflow: it changes only when the invite
// link does.
{
  "name": "wasmcloud-slack",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "routes": [
    { "pattern": "slack.wasmcloud.com", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true }
}
