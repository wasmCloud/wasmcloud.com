# The same rule as the .npmrc at the repo root, repeated here because npm
# reads the project .npmrc beside the nearest package.json, and this folder
# has its own: without this file `npx wrangler` here would resolve wrangler's
# dependencies with no minimum age, in the job that holds the publish token.
#
# Resolve only versions that have been on the registry for at least 7 days,
# so a compromised release has time to be caught and unpublished upstream.
# Needs npm 11.10.0 or later; older npm ignores this setting.
min-release-age=7
