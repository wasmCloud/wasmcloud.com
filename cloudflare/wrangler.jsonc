// wasmcloud-www: wasmcloud.com on Cloudflare Workers.
//
// This Worker serves production (wasmcloud.com, www, docs.) since the
// cutover from Netlify on 2026-11-19. See CLOUDFLARE-MIGRATION.md for the record of the
// cutover and the rollback steps, worker/src/index.js for what the Worker
// does and scripts/netlify2cf.py for where its routing table comes from.
//
//   make cf        build build/assets and worker/routes.generated.json
//   make cf-dev    run it locally on :8787
//
// Deploy with the pinned CLI, never a floating one:
//   make cf-deploy
// No account_id here on purpose: CI supplies CLOUDFLARE_ACCOUNT_ID, and a
// local deploy uses whichever account `wrangler login` selected.
{
  "name": "wasmcloud-www",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-11-01",

  "assets": {
    // A copy of the Docusaurus build without the Netlify _headers file, plus
    // the Markdown twins under _md/. Built by `make cf`.
    "directory": "./build/assets",
    "binding": "ASSETS",
    // The Worker sees every request: redirects and the AI-agent branch have
    // to run before a file is served.
    "run_worker_first": true,
    // The asset layer serves exact files and nothing else. Trailing slashes,
    // index.html and the 404 page are decided in the Worker so they can match
    // Netlify's behaviour.
    "html_handling": "none",
    "not_found_handling": "none"
  },

  // The live hostnames. Removing a hostname from this list
  // and deploying detaches it and deletes its DNS record, which takes that
  // hostname offline: do that only as a rollback (CLOUDFLARE-MIGRATION.md).
  // Wrangler will not replace a DNS record it did not create: attaching a
  // new hostname means deleting its existing record first.
  //
  // The test hostname next.wasmcloud.com was removed on 2026-11-19, after
  // the cutover. To bring a test copy back, add { "pattern":
  // "next.wasmcloud.com", "custom_domain": true } (and "docs-next" to try the
  // docs.wasmcloud.com redirects): TEST_HOSTS and HOST_ALIASES below still
  // name both, so they come back noindex.
  "routes": [
    { "pattern": "wasmcloud.com", "custom_domain": true },
    { "pattern": "www.wasmcloud.com", "custom_domain": true },
    { "pattern": "docs.wasmcloud.com", "custom_domain": true }
  ],
  // Off. Pull-request preview versions still get their own workers.dev URL
  // (preview_urls), and every response on one is noindex.
  "workers_dev": false,
  "preview_urls": true,

  // One row per AI-agent request: path, agent, markdown or html, host.
  "analytics_engine_datasets": [
    { "binding": "AGENT_HITS", "dataset": "wasmcloud_www_agent_hits" }
  ],

  "vars": {
    // Comma-separated hosts that get X-Robots-Tag: noindex, nofollow on every
    // response. *.workers.dev is always treated as a test host.
    "TEST_HOSTS": "next.wasmcloud.com,docs-next.wasmcloud.com",
    // "test host=production host" pairs. A request to the left is answered
    // exactly as the Worker would answer the right.
    "HOST_ALIASES": "docs-next.wasmcloud.com=docs.wasmcloud.com"
  },

  "observability": { "enabled": true }
}
