      "updated": 1756100000000,
      "link": null,
      "locked": false,
      "fontSize": 13,
      "fontFamily": 3,
      "text": "maxOutboundHttpConnectionsPerWorkload   128   over quota: waits up to 5s, then fails\nmaxOutboundSocketConnectionsPerWorkload 256   over quota: refused immediately\nmaxInboundSocketConnectionsPerWorkload  256   over quota: refused immediately\nmaxConnections                          host-wide ceiling across all workloads",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "maxOutboundHttpConnectionsPerWorkload   128   over quota: waits up to 5s, then fails\nmaxOutboundSocketConnectionsPerWorkload 256   over quota: refused immediately\nmaxInboundSocketConnectionsPerWorkload  256   over quota: refused immediately\nmaxConnections                          host-wide ceiling across all workloads",
      "lineHeight": 1.25
    },
